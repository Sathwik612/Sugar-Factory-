# Copy this file to .env for non-Replit local development.
# Use placeholders only here. Never commit a real .env file.
DATABASE_URL=

# The app can use individual PostgreSQL variables when DATABASE_URL is omitted.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=sugar_factory

# Use a long random value outside source control in real environments.
SESSION_SECRET=

# Local service settings. The API defaults to 8080 and the web app defaults to 5173.
PORT=8080
WEB_PORT=5173
API_ORIGIN=http://localhost:8080
BASE_PATH=/

# Optional server logging level.
LOG_LEVEL=info

# Production hardening. Use an HTTPS origin, comma-separated when needed.
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=256kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
PGPOOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=30000
READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000

# Demo seeding defaults on in development and off in production.
SEED_DEMO_DATA=true

# Web push readiness. Store all three production values in Replit Secret storage.
# Generate one VAPID key pair and keep the public/private keys together.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:alerts@example.invalid