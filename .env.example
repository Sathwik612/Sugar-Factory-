# Copy this file to .env for non-Replit local development.
# Use placeholders only here. Never commit a real .env file.
DATABASE_URL=

# The app can use individual PostgreSQL variables when DATABASE_URL is omitted.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=sugar_factory

# Use a long random value outside source control in real environments.
SESSION_SECRET=

# Local service settings. Replit workflows provide their own PORT and BASE_PATH.
PORT=8080
BASE_PATH=/

# Optional server logging level.
LOG_LEVEL=info