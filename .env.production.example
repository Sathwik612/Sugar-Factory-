# Production template for a generic VPS. Copy to .env and fill every required value.
# Keep this file outside source control. Use a managed PostgreSQL service or the
# PostgreSQL service in compose.yaml, and terminate HTTPS at the host reverse proxy.
NODE_ENV=production
PORT=8080
WEB_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1

PGHOST=db
PGPORT=5432
PGUSER=sugar_factory
PGPASSWORD=replace-with-a-long-random-password
PGDATABASE=sugar_factory

SESSION_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGIN=https://sugar.example.com
TRUST_PROXY=1
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
SEED_DEMO_DATA=false

PGPOOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=30000
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=256kb
SOURCE_FILE_MAX_BYTES=10485760
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000

# Choose exactly one production storage provider.
# S3-compatible storage is preferred for multi-host durability.
STORAGE_PROVIDER=s3
STORAGE_LOCAL_PATH=/var/lib/sugar-factory/uploads
S3_BUCKET=sugar-factory-source-files
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret

# Optional web-push delivery. Leave all three empty to disable it.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:alerts@example.com